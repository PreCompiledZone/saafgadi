# SaafGadi configuration. Copy to .env and fill in. Real environment variables
# (e.g. set in hPanel) override values from this file. Point ENV_FILE at a
# different file to load it instead of .env.

# --- App ---
NODE_ENV=production            # production | development | test
PORT=3000                      # Hostinger may provide PORT; always read from env
APP_URL=https://yourdomain.com # public URL of the app
APP_NAME=SaafGadi              # shown in the title, header, landing page and WhatsApp text
APP_TIMEZONE=Asia/Kolkata      # all business dates (wash days, validity) use this zone

# --- Database (values from hPanel → Databases) ---
DB_HOST=                       # e.g. localhost or the host shown in hPanel
DB_PORT=3306                   # MySQL port
DB_NAME=                       # database name
DB_USER=                       # database user
DB_PASSWORD=                   # database user's password
DB_CONNECTION_LIMIT=5          # pool size; keep small on shared hosting

# --- Auth ---
JWT_SECRET=                    # long random string, min 32 chars
JWT_EXPIRES_IN=7d              # login session length (e.g. 7d, 12h)
COOKIE_SECURE=true             # false only for local http dev
BCRYPT_ROUNDS=10               # password hashing cost (8–14)

# --- First admin (used only if no admin exists yet) ---
SEED_ADMIN_NAME=               # display name of the first admin
SEED_ADMIN_MOBILE=             # 10-digit mobile, used to log in
SEED_ADMIN_EMAIL=              # optional
SEED_ADMIN_PASSWORD=           # min 8 chars; remove after first login

# --- Migrations ---
RUN_MIGRATIONS_ON_START=true   # create/upgrade tables when the app starts

# --- Logging ---
LOG_LEVEL=info                 # debug | info | warn | error
